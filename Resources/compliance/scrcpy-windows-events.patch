+#ifdef _WIN32
+// Win32 title-bar maximize is handled on the SDL UI thread. When grouping
+// is enabled by the host, notify it instead of applying single-window zoom.
+static LRESULT CALLBACK
+sc_hosmirror_caption(HWND window, UINT message, WPARAM wparam, LPARAM lparam,
+                     UINT_PTR id, DWORD_PTR data) {
+    if (message == WM_NCDESTROY) {
+        RemoveWindowSubclass(window, sc_hosmirror_caption, id);
+    } else if (message == WM_NCLBUTTONDBLCLK && wparam == HTCAPTION) {
+        DWORD_PTR ignored;
+        // The host responds synchronously with a Boolean. Timeout preserves
+        // native behavior if the host is busy or has already exited.
+        HWND host = (HWND) (uintptr_t) data;
+        if (SendMessageTimeoutW(host, WM_APP + 2, (WPARAM) window, 0,
+                               SMTO_ABORTIFHUNG | SMTO_BLOCK, 180, &ignored)
+                && ignored) {
+            return 0;
+        }
+    }
+    return DefSubclassProc(window, message, wparam, lparam);
+}
+
+static void
+sc_hosmirror_setup_caption(SDL_Window *window) {
+    const char *target = SDL_getenv("HOSMIRROR_WINDOWS_HOST");
+    if (!target || !*target) {
+        return;
+    }
+    char *end;
+    uintptr_t host = (uintptr_t) strtoull(target, &end, 16);
+    if (!host || *end) {
+        return;
+    }
+    SDL_PropertiesID props = SDL_GetWindowProperties(window);
+    HWND hwnd = SDL_GetPointerProperty(props, SDL_PROP_WINDOW_WIN32_HWND_POINTER,
+                                      NULL);
+    if (hwnd) {
+        SetWindowSubclass(hwnd, sc_hosmirror_caption, 1, (DWORD_PTR) host);
+    }
+}
+#endif
 
