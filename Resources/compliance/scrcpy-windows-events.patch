+// A managed scrcpy client reports drop batches over its existing stdout pipe.
+// Encoding the UTF-8 bytes keeps control characters and arbitrary file names
+// out of the framing. Standalone scrcpy keeps its original drag/drop behavior.
+static bool
+sc_hosmirror_handle_drop(const SDL_Event *event) {
+    if (event->type != SDL_EVENT_DROP_BEGIN
+            && event->type != SDL_EVENT_DROP_FILE
+            && event->type != SDL_EVENT_DROP_COMPLETE) {
+        return false;
+    }
+    if (!SDL_getenv("HOSMIRROR_WINDOWS_EVENTS")) {
+        return false;
+    }
+    if (event->type == SDL_EVENT_DROP_FILE && event->drop.data) {
+        static const char hex[] = "0123456789abcdef";
+        size_t len = strlen(event->drop.data);
+        if (len <= 32768 * 4) {
+            char *line = malloc(2 * len + 32);
+            if (!line) {
+                LOG_OOM();
+                return true;
+            }
+            const char prefix[] = "HOSMIRROR_WINDOWS DROP ";
+            memcpy(line, prefix, sizeof(prefix) - 1);
+            size_t offset = sizeof(prefix) - 1;
+            for (size_t i = 0; i < len; ++i) {
+                unsigned char byte = (unsigned char) event->drop.data[i];
+                line[offset++] = hex[byte >> 4];
+                line[offset++] = hex[byte & 15];
+            }
+            line[offset++] = '\n';
+            line[offset] = '\0';
+            fputs(line, stdout);
+            free(line);
+        }
+    } else if (event->type == SDL_EVENT_DROP_COMPLETE) {
+        fputs("HOSMIRROR_WINDOWS DROP_END\n", stdout);
+    }
+    fflush(stdout);
+    return true;
+}
+#endif
